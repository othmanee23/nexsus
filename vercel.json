{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.nexsus.ma"
        }
      ],
      "destination": "https://nexsus.ma/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/fr",
      "destination": "/"
    },
    {
      "source": "/ar",
      "destination": "/"
    },
    {
      "source": "/fr/(.*)",
      "destination": "/"
    },
    {
      "source": "/ar/(.*)",
      "destination": "/"
    },
    {
      "source": "/about",
      "destination": "/"
    },
    {
      "source": "/contact",
      "destination": "/"
    },
    {
      "source": "/insight",
      "destination": "/"
    },
    {
      "source": "/insight/(.*)",
      "destination": "/"
    },
    {
      "source": "/((?!api/|images/|robots.txt|sitemap.xml|assets/).*)",
      "destination": "/index.html"
    }
  ]
}

{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.nexsus.ma"
        }
      ],
      "destination": "https://nexsus.ma/$1",
      "permanent": true
    },
    {
      "source": "/insight",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/insight/:slug",
      "destination": "/insights/:slug",
      "permanent": true
    },
    {
      "source": "/:language(fr|ar)/insight",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/:language(fr|ar)/insight/:slug",
      "destination": "/insights/:slug",
      "permanent": true
    }
  ]
}
